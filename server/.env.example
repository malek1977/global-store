# ---- Global Store API ----
NODE_ENV=production
PORT=8080

# Postgres / SQLite connection (libsql-compatible URL works for Turso)
DATABASE_URL=file:./data/global-store.db

# 64+ char random secret — ROTATE THIS IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars-long-0123456789
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Comma-separated origins allowed to call the API
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Brute-force protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MS=900000

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
